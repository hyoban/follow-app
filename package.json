{
  "name": "follow-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android --device",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:preview:local": "eas build --profile preview --local",
    "build:prod": "eas build --profile production",
    "generate:icons": "svgr --out-dir components/icons --filename-case kebab --jsx-runtime automatic --native --typescript --ref --memo --replace-attr-values '#10161F'='currentColor' --svg-props viewBox='0 0 24 24' --svg-props color='{theme.colors.gray12}' --template svgr/template.js --index-template svgr/index-template.js -- icons/mgc && node svgr/after-generate.js",
    "ios": "expo run:ios --device",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prebuild": "expo prebuild",
    "prepare": "simple-git-hooks",
    "start": "expo start --dev-client",
    "typecheck": "tsc",
    "web": "expo start --web"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.0.6",
    "@gorhom/portal": "^1.0.14",
    "@mozilla/readability": "^0.5.0",
    "@radix-ui/colors": "^3.0.0",
    "@react-native-menu/menu": "^1.1.7",
    "@react-navigation/elements": "^2.2.4",
    "@react-navigation/native": "^7.0.13",
    "@shopify/flash-list": "1.7.1",
    "date-fns": "^4.1.0",
    "dnum": "^2.14.0",
    "drizzle-orm": "^0.38.0",
    "expo": "~52.0.17",
    "expo-av": "15.0.1",
    "expo-background-fetch": "13.0.3",
    "expo-clipboard": "7.0.0",
    "expo-constants": "17.0.3",
    "expo-dev-client": "5.0.5",
    "expo-drizzle-studio-plugin": "^0.1.1",
    "expo-font": "13.0.1",
    "expo-image": "2.0.3",
    "expo-linking": "7.0.3",
    "expo-navigation-bar": "4.0.5",
    "expo-notifications": "0.29.11",
    "expo-router": "4.0.11",
    "expo-sharing": "13.0.0",
    "expo-splash-screen": "~0.29.16",
    "expo-sqlite": "15.0.3",
    "expo-status-bar": "2.0.0",
    "expo-system-ui": "4.0.5",
    "expo-task-manager": "12.0.3",
    "expo-web-browser": "14.0.1",
    "hast-util-to-jsx-runtime": "^2.3.2",
    "html-react-parser": "^5.2.0",
    "jotai": "^2.10.3",
    "jotai-effect": "^1.0.5",
    "linkedom": "^0.18.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.3",
    "react-native-background-fetch": "^4.2.7",
    "react-native-context-menu-view": "^1.16.0",
    "react-native-gesture-handler": "^2.21.2",
    "react-native-inappbrowser-reborn": "^3.7.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^2.12.2",
    "react-native-modal": "^13.0.1",
    "react-native-modalfy": "^3.5.5",
    "react-native-pager-view": "6.5.1",
    "react-native-reanimated": "~3.16.4",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.3.0",
    "react-native-svg": "15.8.0",
    "react-native-tab-view": "^4.0.5",
    "react-native-track-player": "^4.1.1",
    "react-native-unistyles": "^2.20.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "shaka-player": "^4.12.4",
    "sonner-native": "^0.16.2",
    "swr": "^2.2.5",
    "tldts": "^6.1.66",
    "unified": "^11.0.5",
    "vfile": "5.3.7",
    "zod": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@hono/node-server": "^1.13.7",
    "@iconify/json": "^2.2.281",
    "@iconify/tools": "^4.0.7",
    "@iconify/utils": "^2.2.0",
    "@svgr/cli": "^8.1.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/react": "~18.3.14",
    "autoprefixer": "^10.4.20",
    "babel-plugin-inline-import": "^3.0.0",
    "better-auth": "^1.0.15",
    "better-call": "0.3.3-beta.4",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.16.0",
    "eslint-config-hyoban": "^3.1.15",
    "hono": "^4.6.13",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.49",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^3.4.16",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "devlop@1.1.0": "patches/devlop@1.1.0.patch"
    },
    "overrides": {
      "vfile": "5.3.7"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "react-native-gesture-handler",
        "expo-linking",
        "react-native-screens"
      ]
    }
  }
}
